{
  "name": "@smuzi/tests",
  "version": "0.0.3",
  "description": "Test runner and assertion library for JavaScript and TypeScript",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "types": "./build/index.d.ts",
  "keywords": [
    "test",
    "test runner",
    "assert",
    "assertion"
  ],
  "author": "Denis Ratushniak <dinisimys2018@gmail.com>",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./src",
    "./build"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "imports": {
    "#lib/*": "./src/*"
  },
  "dependencies": {
    "@smuzi/std": "workspace:*",
    "@smuzi/schema": "workspace:*",
    "@smuzi/console": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^7.0.2"
  }
}
