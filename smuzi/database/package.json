{
  "name": "@smuzi/database",
  "version": "0.0.9",
  "description": "Database access layer and migrations toolkit for JavaScript and TypeScript",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "types": "./build/index.d.ts",
  "keywords": [
    "database",
    "migrations",
    "query"
  ],
  "author": "Denis Ratushniak <dinisimys2018@gmail.com>",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./*": {
        "types": "./build/*.d.ts",
        "default": "./build/*.js"
      }
    }
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#lib/*": "./src/*"
  },
  "peerDependencies": {
    "@smuzi/std": "workspace:^",
    "@smuzi/schema": "workspace:^",
    "@smuzi/console": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^7.0.2"
  }
}
