{
  "name": "@smuzi/std",
  "version": "0.2.4",
  "description": "Standard library for JavaScript and TypeScript",
  "scripts": {
    "test": "tsx --conditions=development tests/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "types": "./build/index.d.ts",
  "keywords": [
    "std",
    "standard library",
    "match",
    "pattern matching",
    "result",
    "option"
  ],
  "author": "Denis Ratushniak <dinisimys2018@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/**/*.ts",
    "build/**/*.js"
  ],
   "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
 "imports": {
    "#lib/*": "./src/*"
  },
  "devDependencies": {
    "@smuzi/faker": "workspace:*",
    "@smuzi/schema": "workspace:*",
    "@smuzi/tests": "workspace:*",
    "@types/node": "^22.15.21",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
