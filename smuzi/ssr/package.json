{
  "name": "@smuzi/ssr",
  "version": "0.0.7",
  "description": "Simple template engine for generation HTML pages with advanced syntaxes",
  "scripts": {
    "test": "tsx tests/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "types": "./build/index.d.ts",
  "keywords": [
    "ssr",
    "ssg",
    "server side rendering",
    "template",
    "html",
    "render",
    "view"
  ],
  "author": "Denis Ratushniak <dinisimys2018@gmail.com>",

  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./globals.d.ts": "./globals.d.ts",
      "./*": {
        "types": "./build/*.d.ts",
        "default": "./build/*.js"
      }
    }
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "globals.d.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./globals.d.ts": "./globals.d.ts",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#lib/*": "./src/*"
  },
  "peerDependencies": {
    "@smuzi/std": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "@smuzi/tests": "workspace:^",
    "@smuzi/faker": "workspace:^"
  }
}
