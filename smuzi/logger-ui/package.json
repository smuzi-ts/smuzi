{
  "name": "@smuzi/logger-ui",
  "version": "0.0.3",
  "description": "Web UI for browsing logs",
  "scripts": {
    "build": "pnpm run build:ui && tsc --project tsconfig.build.json",
    "build:ui": "pnpm run build:ui:js && pnpm run build:ui:css && cp ui/index.html ui/login.html build/ui/",
    "build:ui:js": "esbuild ui/src/main.ts --bundle --minify --format=iife --target=es2022 --outfile=build/ui/app.js",
    "build:ui:css": "tailwindcss --input ui/src/app.css --output build/ui/app.css --minify",
    "check:ui": "tsc --project tsconfig.ui.json",
    "serve": "tsx --env-file=dev/.env dev/serve.ts",
    "prepublishOnly": "npm run build",
    "console": "tsx --env-file=dev/.env dev/console.ts"
  },
  "type": "module",
  "types": "./build/index.d.ts",
  "keywords": [
    "logs",
    "logger",
    "ui",
    "trace",
    "observability"
  ],
  "author": "Denis Ratushniak <dinisimys2018@gmail.com>",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./*": {
        "types": "./build/*.d.ts",
        "default": "./build/*.js"
      }
    }
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "build/ui/**"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#lib/*": "./src/*"
  },
  "peerDependencies": {
    "@smuzi/console": "workspace:^",
    "@smuzi/database": "workspace:^",
    "@smuzi/http-client": "workspace:^",
    "@smuzi/http-server": "workspace:^",
    "@smuzi/logger": "workspace:^",
    "@smuzi/std": "workspace:^"
  },
  "devDependencies": {
    "@smuzi/console": "workspace:^",
    "@smuzi/database": "workspace:^",
    "@smuzi/db-postgres": "workspace:^",
    "@smuzi/http-client": "workspace:^",
    "@tailwindcss/cli": "^4.3.3",
    "@types/alpinejs": "^3.13.11",
    "@types/node": "^22.15.21",
    "alpinejs": "^3.17.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
