{
  "name": "@smuzi/db-postgres",
  "version": "0.0.3",
  "description": "PostgreSQL driver for @smuzi/database",
  "scripts": {
    "test": "tsx  --env-file=.env tests/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "types": "./build/index.d.ts",
  "keywords": [
    "database",
    "postgres",
    "postgresql",
    "pg"
  ],
  "author": "Denis Ratushniak <dinisimys2018@gmail.com>",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./src",
    "./build"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "imports": {
    "#lib/*": "./src/*"
  },
  "dependencies": {
    "@smuzi/database": "workspace:*",
    "@smuzi/std": "workspace:*",
    "@smuzi/schema": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@smuzi/faker": "workspace:*",
    "@smuzi/tests": "workspace:*",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.10",
    "typescript": "^7.0.2"
  }
}
