{
  "name": "@smuzi/http-client",
  "version": "0.0.3",
  "description": "HTTP client for JavaScript and TypeScript",
  "scripts": {
    "test": "tsx --env-file=./tests/.env tests/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "types": "./build/index.d.ts",
  "keywords": [
    "http",
    "api",
    "rest",
    "json",
    "request"
  ],
  "author": "Denis Ratushniak <dinisimys2018@gmail.com>",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./src",
    "./build",
    "./tests"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "imports": {
    "#lib/*": "./src/*"
  },
  "dependencies": {
    "@smuzi/std": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "@smuzi/faker": "workspace:*",
    "@smuzi/tests": "workspace:*",
    "@smuzi/schema": "workspace:*",
    "@smuzi/http-server": "workspace:*"
  }
}
